{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mytube",
  "version": "0.1.1",
  "identifier": "uk.blyat.mytube",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyTube",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/mytube/thumbs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "blyat-uk",
    "homepage": "https://github.com/blyat-uk/mytube",
    "copyright": "Copyright © 2026 blyat-uk",
    "category": "Video",
    "shortDescription": "A desktop YouTube subscription feed and downloader",
    "longDescription": "MyTube — a desktop YouTube subscription feed and downloader. It follows channels without a Google account, downloads videos with yt-dlp, hands playback to the video player you already use, and keeps track of what you have watched. Nothing is ever written back to YouTube.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}